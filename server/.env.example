# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL Database Connection (Pooled & Direct)
DATABASE_URL="postgresql://username:password@ep-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-direct.region.neon.tech/neondb?sslmode=require"

# Google Gemini API Key (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_ANALYSIS_MODEL=gemini-flash-lite-latest
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Brevo SMTP Configuration for Password Reset Mails
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_user
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SMTP_FROM=your_email@example.com

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
